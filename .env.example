# Copy this file to ".env" and fill in your key. Never commit the real .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Models are tried in this order. If none of them exist for your key (Google retires models
# regularly), the app asks the API which Flash models your key can use and picks one itself.
# Run "python list_models.py" to see them. You can also leave these two lines out entirely.
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated models to try if the main one is rate limited or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# 0.8 to 1.0 gives good variety between posts.
GEMINI_TEMPERATURE=0.9

# How many times the app asks Gemini to fix a post that fails the server-side checks.
MAX_FIX_ATTEMPTS=2

# Where the SQLite history and uploaded photos are stored (default: ./data).
# GBP_DATA_DIR=./data

# Server (local only by default).
# HOST=127.0.0.1
# PORT=5000

# Options left on Auto (layout, opener, closer, length, tone) are picked at random by the app.
# Set to 0 to let Gemini decide instead.
# GBP_RANDOMIZE_AUTO=1
